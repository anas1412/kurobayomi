        [one] { NUMBER($count, useGrouping: "false") } fejezet kihagyása, hiányzik a forrás, vagy ki lett szűrve
       *[other] { NUMBER($count, useGrouping: "false") } fejezet kihagyása, hiányoznak a források, vagy ki lettek szűrve
    }

notification_new_chapters_summary =
    { $count ->
        [one] { NUMBER($count, useGrouping: "false") } elemnek
       *[other] { NUMBER($count, useGrouping: "false") } elemnek
    }

notification_chapters_generic =
    { $count ->
        [one] 1 új fejezet
       *[other] { NUMBER($count, useGrouping: "false") } új fejezet
    }

notification_chapters_multiple_and_more =
    { $count ->
        [one] { $arg1 } fejezet és még 1
       *[other] { $arg1 } fejezet és még { NUMBER($count, useGrouping: "false") }
    }

update_check_notification_ext_updates =
    { $count ->
        [one] Egy új bővítményfrissítés érhető el
       *[other] { NUMBER($count, useGrouping: "false") } bővítményfrissítés érhető el
    }

num_repos =
    { $count ->
        [one] { NUMBER($count, useGrouping: "false") } repo
       *[other] { NUMBER($count, useGrouping: "false") } repok
    }

