<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Kurobayomi: third-party licences</title>
<style>
    body { font: 15px/1.5 sans-serif; margin: 2em auto; max-width: 52em; padding: 0 1em; color: #1a1b26; background: #fff; }
    @media (prefers-color-scheme: dark) { body { color: #c0caf5; background: #1a1b26; } a { color: #7aa2f7; } }
    pre { white-space: pre-wrap; font-size: 12px; }
    li { margin: 0.2em 0; }
    .licenses-list { columns: 2; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Kurobayomi is licensed under Apache-2.0 (see NOTICE). It uses these libraries:</p>

<h2>Overview</h2>
<ul class="licenses-list">
{{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

<h2>Licences</h2>
<ul class="licenses-list">
{{#each licenses}}
    <li id="{{id}}">
        <h3>{{name}}</h3>
        <h4>Used by:</h4>
        <ul>
        {{#each used_by}}
            <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
        </ul>
        <pre>{{text}}</pre>
    </li>
{{/each}}
</ul>
</body>
</html>
